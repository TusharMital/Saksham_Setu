{
  "version": "1.0.0",
  "nsfdc_rules": {
    "eligible_categories": ["SC"],
    "max_annual_income": 500000,
    "citation": "NSFDC Lending Policy & MoSJE Scheduled Castes Welfare Guidelines (Annual Family Income <= Rs 5,00,000)"
  },
  "ews_rules": {
    "citation": "DoPT OM No. 36039/1/2019-Estt(Res) dated 31.01.2019 (103rd Constitutional Amendment)",
    "max_annual_income": 800000,
    "excluded_categories": ["SC", "ST", "OBC"],
    "asset_limits": {
      "agricultural_land_acres_max": 5,
      "residential_flat_sqft_max": 1000,
      "residential_plot_notified_sqyd_max": 100,
      "residential_plot_non_notified_sqyd_max": 200
    },
    "issuing_authorities": [
      "Tehsildar",
      "Sub-Divisional Magistrate (SDM)",
      "District Magistrate",
      "Revenue Officer (not below the rank of Tehsildar)"
    ],
    "alternative_schemes": [
      "PM MUDRA Yojana (PMMY)",
      "PMEGP (Prime Minister's Employment Generation Programme)",
      "Stand-Up India (for women entrepreneurs)"
    ]
  },
  "sc_constitutional_rule": {
    "citation": "Constitution (Scheduled Castes) Order, 1950 under Article 341 of the Constitution of India",
    "interstate_migration_note": "Under Article 341, Scheduled Caste status is notified specifically in relation to a particular State or Union Territory. A certificate issued by another state requires domicile/Tehsildar verification in the loan state or central SCA routing."
  },
