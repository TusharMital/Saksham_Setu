{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build && python3 manage.py migrate --noinput && python3 manage.py seed_data",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/admin/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!assets/|favicon\\.ico).*)", "destination": "/index.html" }
  ]
}
